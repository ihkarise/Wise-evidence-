# WiseEvidence — example environment configuration.
# Copy to `.env` and fill in real values locally. NEVER commit a real `.env`.
# Only `.env.example` is tracked. See docs/16-SECURITY.md and docs/19-DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# Public Supabase connection (browser-safe).
# These PUBLIC_ variables are the ONLY Supabase values the frontend may read.
# Access is still governed by Row-Level Security in the database.
# ---------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# ---------------------------------------------------------------------------
# Server-only secrets (NEVER expose to the client, never prefix with PUBLIC_).
# Read only in server-side code (SSR routes, middleware). Never shipped to the
# browser. Left unset in the Supabase pending gate (docs/19 §11).
# ---------------------------------------------------------------------------
# Direct PostgreSQL connection used by the request executor to enforce RLS with
# the caller's role/claims (see apps/web/src/server/db.ts).
# SUPABASE_DB_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# Service-role key — privileged, server-only. Do not ship to the browser.
# SUPABASE_SERVICE_ROLE_KEY=server-only-do-not-ship-to-browser

# ---------------------------------------------------------------------------
# Metadata provider (docs/23 Phase 6). 'mock' (default, deterministic, offline)
# or 'crossref' (server-side calls to api.crossref.org).
# ---------------------------------------------------------------------------
# METADATA_PROVIDER=mock

# ---------------------------------------------------------------------------
# AI enrichment provider (Milestone 6, ADR-016). SERVER-ONLY — never prefix with
# PUBLIC_, never shipped to the browser. 'mock' (default, deterministic, offline;
# used in dev/CI) or 'openai-compatible' for an OpenAI-compatible aggregator
# (OpenRouter, DeepSeek, or a self-hosted open-source gateway). AI output is a
# SUGGESTION only; a human reviews before any value becomes canonical.
# ---------------------------------------------------------------------------
# AI_PROVIDER=mock
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat
# AI_API_KEY=server-only-do-not-ship-to-browser
# Optional attribution header some aggregators request (e.g. OpenRouter):
# AI_REFERER=https://github.com/ihkarise/wise-evidence
# Optional cost measurement (M6.1): the CURRENT per-1M-token price for AI_MODEL,
# taken from the provider's official pricing page. Used only to multiply real,
# provider-reported token usage into an estimated USD cost — never to invent one.
# AI_INPUT_PRICE_PER_M=0.14
# AI_OUTPUT_PRICE_PER_M=0.28
