# WiseEvidence — example environment configuration.
# Copy to `.env` and fill in real values locally. NEVER commit a real `.env`.
# Only `.env.example` is tracked. See docs/16-SECURITY.md and docs/19-DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# Public Supabase connection (browser-safe).
# These PUBLIC_ variables are the ONLY Supabase values the frontend may read.
# Access is still governed by Row-Level Security in the database.
# ---------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# ---------------------------------------------------------------------------
# Server-only secrets (NEVER expose to the client, never prefix with PUBLIC_).
# Not used in Milestone 1 — listed here so their handling is documented.
# A service-role key must only ever be read in server-side code.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=server-only-do-not-ship-to-browser
