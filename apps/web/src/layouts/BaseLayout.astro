---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /**
   * When true, emit `noindex, follow`. Used by filtered/searched/paged views of
   * the explorer so search engines index only the clean canonical entry point
   * and thin per-filter permutations are not indexed (docs/27 §8).
   */
  noindex?: boolean;
}

const { title, description, canonical, noindex } = Astro.props;
const fullTitle = title === "WiseEvidence" ? title : `${title} · WiseEvidence`;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/research", label: "Research" },
  { href: "/methodology", label: "Methodology" },
];
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
  </head>
  <body class="flex min-h-full flex-col bg-white text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-brand focus:px-3 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <header class="border-b border-slate-200">
      <nav
        class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4"
        aria-label="Primary"
      >
        <a href="/" class="text-lg font-semibold tracking-tight text-brand">WiseEvidence</a>
        <ul class="flex gap-6 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-ink-muted transition-colors hover:text-brand"
                  aria-current={Astro.url.pathname === link.href ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" class="mx-auto w-full max-w-4xl flex-1 px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-slate-200 text-sm text-ink-muted">
      <div class="mx-auto flex max-w-4xl flex-col gap-2 px-6 py-8">
        <p>
          WiseEvidence is an open-source, early-stage platform. The research catalogue is populated
          only when a database is connected; on this deployment it may be empty.
        </p>
        <p>
          Code is licensed Apache-2.0; curated data (when it exists) will be CC-BY-4.0. See the
          <a
            href="https://github.com/ihkarise/Wise-evidence-"
            class="text-brand underline underline-offset-2">repository</a
          >.
        </p>
      </div>
    </footer>
  </body>
</html>
