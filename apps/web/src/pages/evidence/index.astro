---
/**
 * Public Evidence Pyramid (docs/28 §7, docs/03 §8, docs/06 — Milestone 5).
 *
 * SSR on the ANON database path, so production RLS is the authoritative gate:
 * only PUBLISHED studies are ever counted. The pyramid is a NAVIGATION /
 * ORGANIZATION device — bands are ordered by the taxonomy's pyramid_rank and a
 * band's position carries NO claim about positivity, negativity, truth,
 * treatment effectiveness, or scientific superiority (docs/28 §1.1–1.3). Each
 * band links into the existing M4 explorer filter (/research?evidenceLevel=CODE)
 * — no second filtering system is invented.
 *
 * The page works WITHOUT JavaScript: the counts are server-rendered as text in
 * an ordered list; nothing depends on colour, width, or animation.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatDisclaimer from "../../components/StatDisclaimer.astro";
import {
  getEvidencePyramid,
  getCatalogueOverview,
  type EvidenceBand,
} from "@wise-evidence/database";
import { asAnon, isDatabaseConfigured } from "../../lib/db.js";

export const prerender = false;

const canonical = new URL("/evidence", Astro.site ?? Astro.url).toString();

let bands: EvidenceBand[] | null = null;
let overview: { publishedStudies: number; publishedPublications: number } | null = null;
let loadError = false;
if (isDatabaseConfigured) {
  try {
    [bands, overview] = await asAnon(async (db) => [
      await getEvidencePyramid(db),
      await getCatalogueOverview(db),
    ]);
  } catch {
    loadError = true; // never surface database internals (docs/28 §11)
  }
}

/** Short, strictly neutral descriptions of each design band (navigation only). */
const BAND_NOTES: Record<string, string> = {
  META_ANALYSIS: "Statistical synthesis combining results across multiple studies.",
  SYSTEMATIC_REVIEW: "Structured review that systematically identifies and appraises studies.",
  RCT: "Trial that randomly allocates participants between groups.",
  CONTROLLED_TRIAL: "Comparative trial without randomized allocation.",
  OBSERVATIONAL:
    "Cohort, case-control and cross-sectional studies without an intervention assignment.",
  CASE_SERIES: "Description of outcomes across a group of cases.",
  CASE_REPORT: "Detailed report of a single case.",
  PRECLINICAL: "Animal or in-vitro research — not conducted in humans.",
  EXPERT_OPINION: "Narrative or expert commentary rather than primary empirical data.",
  OTHER: "Records whose study type is other or was explicitly classified as unclassified.",
  UNCLASSIFIED: "Published records that do not yet have an assigned study type / evidence level.",
};

const totalStudies = bands ? bands.reduce((a, b) => a + b.studyCount, 0) : 0;

const description =
  "Browse published homeopathy research by evidence level. The evidence pyramid is a navigation device that groups studies by design type — it does not rank studies by outcome, quality, or treatment effectiveness.";
---

<BaseLayout title="Evidence Pyramid" description={description} canonical={canonical}>
  <div class="max-w-4xl">
    <p class="text-sm font-medium uppercase tracking-wide text-brand">Evidence</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink">Evidence Pyramid</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      A way to <strong>navigate</strong> the published catalogue by study design. Studies are grouped
      into evidence levels ordered by the <code class="rounded bg-slate-100 px-1">taxonomy-v1</code>
      pyramid rank. This ordering organizes browsing; it is <strong>not</strong> a scientific ranking.
    </p>

    <div class="mt-6">
      <StatDisclaimer variant="pyramid" />
    </div>

    {
      !isDatabaseConfigured ? (
        <div
          class="mt-8 rounded-lg border border-amber-300 bg-amber-50 px-5 py-4 text-sm text-amber-900"
          role="note"
        >
          <strong class="font-semibold">Catalogue not connected.</strong> This deployment has no
          database configured yet, so there are no studies to group. The pyramid is waiting on a
          provisioned Supabase project.
        </div>
      ) : loadError ? (
        <div
          class="mt-8 rounded-lg border border-red-300 bg-red-50 px-5 py-4 text-sm text-red-900"
          role="alert"
        >
          Something went wrong loading the evidence pyramid. Please try again.
        </div>
      ) : bands && totalStudies > 0 ? (
        <>
          <p class="mt-8 text-sm text-ink-muted">
            <strong>{overview?.publishedStudies ?? totalStudies}</strong> published{" "}
            {(overview?.publishedStudies ?? totalStudies) === 1 ? "study" : "studies"}
            {overview && (
              <span>
                {" "}
                across <strong>{overview.publishedPublications}</strong>{" "}
                {overview.publishedPublications === 1 ? "publication" : "publications"}
              </span>
            )}
            . Each study is counted once, in a single band.
          </p>

          {/* Ordered list: rank order top → bottom. Full-width bands (equal
              width) so nothing implies "wider = stronger". The rank badge and
              order convey the taxonomy hierarchy; the count is plain text. */}
          <ol class="mt-4 space-y-2" role="list">
            {bands.map((band) => (
              <li>
                <div
                  class={`flex flex-col gap-2 rounded-lg border p-4 sm:flex-row sm:items-center sm:gap-4 ${
                    band.isUnclassified
                      ? "border-dashed border-slate-300 bg-slate-50"
                      : "border-slate-200 bg-white"
                  }`}
                >
                  <div
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-600"
                    aria-hidden="true"
                  >
                    {band.rank ?? "—"}
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-baseline gap-x-2">
                      <h2 class="text-base font-semibold text-ink">{band.label}</h2>
                      <span class="text-sm text-ink-muted">
                        {band.studyCount} {band.studyCount === 1 ? "study" : "studies"}
                      </span>
                    </div>
                    <p class="mt-0.5 text-sm text-ink-muted">{BAND_NOTES[band.code] ?? ""}</p>
                  </div>
                  <div class="shrink-0">
                    {band.isUnclassified ? (
                      <span class="text-xs text-slate-400">no evidence-level filter</span>
                    ) : (
                      <a
                        href={`/research?evidenceLevel=${encodeURIComponent(band.code)}`}
                        class="text-sm font-medium text-brand hover:underline"
                      >
                        {band.studyCount > 0 ? "Browse studies →" : "Browse →"}
                      </a>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ol>

          <p class="mt-6 text-xs text-slate-500">
            Order reflects the taxonomy pyramid rank (a navigation convention). It does not indicate
            that a higher level is more positive, more true, or evidence of greater treatment
            effectiveness. Preclinical research is browsable but is not equivalent to clinical-trial
            evidence.
          </p>
        </>
      ) : (
        <div
          class="mt-8 rounded-lg border border-slate-200 bg-white px-5 py-8 text-center"
          role="note"
        >
          <p class="text-sm font-medium text-ink">
            No published research is currently available in this catalogue.
          </p>
          <p class="mt-1 text-sm text-ink-muted">
            Evidence levels will populate as research is published.
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
