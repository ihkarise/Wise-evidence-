---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { listImportJobs, type ImportJobRow } from '@wise-evidence/database';
import { getDiscoveryConnector } from '../../../server/discovery.ts';
import { withActor } from '../../../server/db.ts';

const staff = Astro.locals.staff!;
let jobs: ImportJobRow[] = [];
let pending = false;
try {
  jobs = await withActor({ role: 'authenticated', sub: staff.sub }, (exec) => listImportJobs(exec));
} catch {
  pending = true;
}
const connectorName = getDiscoveryConnector().name;
---

<BaseLayout title="Discovery / imports — WiseEvidence admin">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Automated research discovery</h1>
    <a class="text-sm underline" href="/admin">← Admin</a>
  </div>
  <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
    Discovery finds <strong>candidate</strong> research from a source. A candidate is
    only a suggestion for review — it is never classified or published automatically.
    Approving a candidate creates a <strong>draft</strong> in the normal review workflow.
    Active connector: <code>{connectorName}</code>.
  </p>

  {pending && (
    <p class="mt-6 rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-200">
      Database not configured in this environment (Supabase pending gate — docs/19 §11).
    </p>
  )}

  <section class="mt-6 rounded-md border border-slate-200 p-4 dark:border-slate-800">
    <h2 class="text-lg font-semibold">Run a discovery job</h2>
    <form id="run" class="mt-3 flex flex-wrap items-end gap-3">
      <label class="block text-sm">Query
        <input name="query" required class="mt-1 block w-72 rounded-md border border-slate-300 px-3 py-2 dark:border-slate-600 dark:bg-slate-900" placeholder="e.g. homeopathy allergic rhinitis" />
      </label>
      <label class="block text-sm">Source name
        <input name="sourceName" class="mt-1 block w-48 rounded-md border border-slate-300 px-3 py-2 dark:border-slate-600 dark:bg-slate-900" placeholder={connectorName} />
      </label>
      <label class="block text-sm">Max results
        <input name="maxResults" type="number" min="1" max="50" value="10" class="mt-1 block w-24 rounded-md border border-slate-300 px-3 py-2 dark:border-slate-600 dark:bg-slate-900" />
      </label>
      <button type="submit" class="rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white dark:bg-slate-100 dark:text-slate-900">Discover</button>
    </form>
    <p id="run-msg" class="mt-2 text-sm" aria-live="polite"></p>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold">Import jobs</h2>
    {jobs.length === 0 && !pending && <p class="mt-2 text-sm text-slate-500">No discovery jobs yet.</p>}
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-slate-500">
          <tr>
            <th scope="col" class="py-1 pr-4">Source</th>
            <th scope="col" class="py-1 pr-4">State</th>
            <th scope="col" class="py-1 pr-4">Discovered</th>
            <th scope="col" class="py-1 pr-4">Candidates</th>
            <th scope="col" class="py-1 pr-4">Duplicates</th>
            <th scope="col" class="py-1 pr-4">Imported</th>
            <th scope="col" class="py-1 pr-4">Errors</th>
            <th scope="col" class="py-1 pr-4">Started</th>
            <th scope="col" class="py-1"></th>
          </tr>
        </thead>
        <tbody>
          {jobs.map((j) => (
            <tr class="border-t border-slate-200 dark:border-slate-800">
              <td class="py-2 pr-4">{j.source_name}</td>
              <td class="py-2 pr-4">{j.state}</td>
              <td class="py-2 pr-4">{j.discovered_count}</td>
              <td class="py-2 pr-4">{j.candidate_count}</td>
              <td class="py-2 pr-4">{j.duplicate_count}</td>
              <td class="py-2 pr-4">{j.imported_count}</td>
              <td class="py-2 pr-4">{j.error_count}</td>
              <td class="py-2 pr-4">{new Date(j.started_at).toISOString().slice(0, 16).replace('T', ' ')}</td>
              <td class="py-2"><a class="underline" href={`/admin/imports/${j.id}`}>Review</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <script>
    const form = document.getElementById('run') as HTMLFormElement | null;
    const msg = document.getElementById('run-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '';
      if (msg) msg.textContent = 'Discovering…';
      const res = await fetch('/api/admin/imports/run', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ query: val('query'), sourceName: val('sourceName') || undefined, maxResults: Number(val('maxResults')) || undefined }),
      });
      const data = await res.json();
      if (!data.ok) {
        if (msg) msg.textContent = `Error: ${data.error}`;
        return;
      }
      if (msg) msg.textContent = `Discovered ${data.discovered} (candidates ${data.candidate}, duplicates ${data.duplicate}, malformed ${data.malformed}). Opening…`;
      window.location.href = `/admin/imports/${data.jobId}`;
    });
  </script>
</BaseLayout>
