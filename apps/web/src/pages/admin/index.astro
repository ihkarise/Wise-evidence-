---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listReviewQueue } from '@wise-evidence/database';
import { withActor } from '../../server/db.ts';

// Middleware guarantees locals.staff for /admin/*.
const staff = Astro.locals.staff!;
let queue: { id: string; canonical_title: string; lifecycle_state: string }[] = [];
let pending = false;
try {
  queue = await withActor({ role: 'authenticated', sub: staff.sub }, (exec) => listReviewQueue(exec));
} catch {
  pending = true;
}
---

<BaseLayout title="Admin — WiseEvidence">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Admin</h1>
    <p class="text-sm text-slate-500">Signed in as {staff.role}</p>
  </div>

  <nav class="mt-4 flex gap-3 text-sm">
    <a class="rounded-md bg-slate-900 px-3 py-2 font-medium text-white dark:bg-slate-100 dark:text-slate-900" href="/admin/research/new">+ Add research</a>
    <a class="rounded-md border border-slate-300 px-3 py-2 font-medium dark:border-slate-600" href="/admin/imports">Discovery / imports</a>
  </nav>

  {pending && (
    <p class="mt-6 rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-200">
      Database not configured in this environment (Supabase pending gate — docs/19 §11).
    </p>
  )}

  <section class="mt-8">
    <h2 class="text-lg font-semibold">Review queue</h2>
    {queue.length === 0 && !pending && <p class="mt-2 text-sm text-slate-500">Nothing pending review.</p>}
    <ul class="mt-3 space-y-2">
      {queue.map((r) => (
        <li class="flex items-center justify-between rounded-md border border-slate-200 p-3 text-sm dark:border-slate-800">
          <span>{r.canonical_title}</span>
          <a class="underline" href={`/admin/research/${r.id}`}>Open</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
