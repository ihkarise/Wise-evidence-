---
/**
 * Admin dashboard (docs/26 §8). Staff-only. Summarizes the workflow queue.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listStudies } from "@wise-evidence/database";
import { asService, isDatabaseConfigured } from "../../lib/db.js";

export const prerender = false;

let counts = { DRAFT: 0, PENDING_REVIEW: 0, PUBLISHED: 0, REJECTED: 0, ARCHIVED: 0 };
if (isDatabaseConfigured) {
  const all = await asService((db) => listStudies(db));
  for (const s of all) {
    if (s.publicationState in counts) {
      counts[s.publicationState as keyof typeof counts] += 1;
    }
  }
}

const tiles = [
  { label: "Drafts", value: counts.DRAFT, href: "/admin/research?state=DRAFT" },
  { label: "Pending review", value: counts.PENDING_REVIEW, href: "/admin/review" },
  { label: "Published", value: counts.PUBLISHED, href: "/admin/research?state=PUBLISHED" },
];
---

<AdminLayout title="Dashboard">
  {
    !isDatabaseConfigured && (
      <p class="mb-6 rounded border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        The database is not configured in this environment. The admin workflow is fully implemented
        and tested, but live data requires a Supabase project and <code>SUPABASE_DB_URL</code>. See
        <code>docs/26</code> §25 (Supabase pending gate).
      </p>
    )
  }

  <div class="grid gap-4 sm:grid-cols-3">
    {
      tiles.map((t) => (
        <a href={t.href} class="rounded-lg border border-slate-200 bg-white p-5 hover:border-brand">
          <div class="text-3xl font-bold text-ink">{t.value}</div>
          <div class="mt-1 text-sm text-ink-muted">{t.label}</div>
        </a>
      ))
    }
  </div>

  <div class="mt-8 rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-lg font-semibold text-ink">Start here</h2>
    <p class="mt-1 text-sm text-ink-muted">
      Add a research record from a DOI, edit and classify it, then submit it for review. Only an
      admin can publish — nothing publishes automatically.
    </p>
    <a
      href="/admin/research/new"
      class="mt-4 inline-block rounded-md bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-dark"
      >Add research from a DOI</a
    >
  </div>
</AdminLayout>
