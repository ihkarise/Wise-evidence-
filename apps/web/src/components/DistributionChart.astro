---
// Accessible, valence-neutral distribution bars (ADR-015, docs/24).
// The numeric value and label are always present as TEXT — the bar width is
// decorative (aria-hidden). A single neutral hue is used for every bar so colour
// never implies good/bad, positive/negative, or proven/disproven. An equivalent
// data table is provided for screen readers / tabular reading.
interface Item {
  label: string;
  value: number;
  href?: string;
}
interface Props {
  title: string;
  caption?: string;
  items: Item[];
  unit?: string;
}
const { title, caption, items, unit = 'studies' } = Astro.props;
const max = Math.max(1, ...items.map((i) => i.value));
---

<section class="mt-8">
  <h2 class="text-xl font-semibold">{title}</h2>
  {caption && <p class="mt-1 text-xs text-slate-500">{caption}</p>}

  <ul class="mt-4 space-y-2" role="list">
    {items.map((item) => (
      <li class="grid grid-cols-[minmax(9rem,14rem)_1fr_auto] items-center gap-3 text-sm">
        <span class="truncate">
          {item.href ? <a href={item.href} class="hover:underline">{item.label}</a> : item.label}
        </span>
        <span class="h-3 rounded bg-slate-100 dark:bg-slate-800" aria-hidden="true">
          <span class="block h-3 rounded bg-slate-400 dark:bg-slate-500" style={`width:${item.value === 0 ? 0 : Math.max(3, (item.value / max) * 100)}%`}></span>
        </span>
        <span class="tabular-nums text-slate-600 dark:text-slate-300">{item.value}</span>
      </li>
    ))}
  </ul>

  <details class="mt-3 text-sm">
    <summary class="cursor-pointer text-slate-500">View as table</summary>
    <table class="mt-2 w-full border-collapse text-left">
      <caption class="sr-only">{title}</caption>
      <thead>
        <tr class="border-b border-slate-200 dark:border-slate-800">
          <th scope="col" class="py-1 pr-4 font-medium">Category</th>
          <th scope="col" class="py-1 font-medium">{unit === 'studies' ? 'Research studies' : unit}</th>
        </tr>
      </thead>
      <tbody>
        {items.map((item) => (
          <tr class="border-b border-slate-100 dark:border-slate-900">
            <td class="py-1 pr-4">{item.label}</td>
            <td class="py-1 tabular-nums">{item.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</section>
