---
import type { ResearchCard } from '@wise-evidence/database';

interface Props {
  card: ResearchCard;
}
const { card } = Astro.props;

const OUTCOME_LABELS: Record<string, string> = {
  STRONG_POSITIVE: 'Strong Positive',
  POSITIVE: 'Positive',
  LEANING_POSITIVE: 'Mixed / Leaning Positive',
  NEUTRAL_INCONCLUSIVE: 'Neutral / Inconclusive',
  LEANING_NEGATIVE: 'Mixed / Leaning Negative',
  NEGATIVE: 'Negative',
  STRONG_NEGATIVE: 'Strong Negative',
};
const authorLine = card.authors.slice(0, 3).join(', ') + (card.authors.length > 3 ? ', et al.' : '');
---

<article class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold">
      <a href={`/research/${card.id}`} class="hover:underline">{card.title}</a>
    </h3>
    {card.is_demo && (
      <span class="shrink-0 rounded bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-900 dark:bg-amber-900 dark:text-amber-100">DEMO</span>
    )}
  </div>

  <p class="mt-1 text-sm text-slate-500">
    {authorLine && <span>{authorLine}. </span>}
    {card.journal && <em>{card.journal}. </em>}
    {card.year && <span>{card.year}.</span>}
  </p>

  <!-- Distinct dimensions, shown as separate labeled chips — never one score. -->
  <ul class="mt-3 flex flex-wrap gap-2 text-xs">
    {card.study_type_code && <li class="rounded border border-slate-300 px-2 py-0.5 dark:border-slate-600">Type: {card.study_type_code}</li>}
    {card.evidence_level && <li class="rounded border border-slate-300 px-2 py-0.5 dark:border-slate-600">Evidence: {card.evidence_level}</li>}
    {card.outcome && <li class="rounded border border-slate-300 px-2 py-0.5 dark:border-slate-600">Reported outcome: {OUTCOME_LABELS[card.outcome] ?? card.outcome}</li>}
    {card.quality && <li class="rounded border border-slate-300 px-2 py-0.5 dark:border-slate-600">Quality: {card.quality}</li>}
  </ul>

  {(card.conditions.length > 0 || card.interventions.length > 0) && (
    <p class="mt-2 text-xs text-slate-500">
      {card.conditions.length > 0 && <span>Conditions: {card.conditions.join(', ')}. </span>}
      {card.interventions.length > 0 && <span>Interventions: {card.interventions.join(', ')}.</span>}
    </p>
  )}

  {card.summary && <p class="mt-2 line-clamp-3 text-sm text-slate-700 dark:text-slate-200">{card.summary}</p>}

  <div class="mt-3 flex items-center gap-3 text-xs text-slate-500">
    {card.doi && <code>{card.doi}</code>}
    <a href={`/research/${card.id}`} class="underline">View research →</a>
  </div>
</article>
