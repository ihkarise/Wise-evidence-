{
  "name": "wise-evidence",
  "version": "0.1.0",
  "private": true,
  "description": "WiseEvidence — open, structured, AI-assisted and human-curated evidence platform for homeopathy research. Milestone 1 foundation.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @wise-evidence/web dev",
    "build": "pnpm --filter @wise-evidence/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.9"
  }
}
